{
  "manifest_version": 3,
  "name": "Ambient light for Bilibili",
  "version": "0.5.0",
  "description": "让 Bilibili 视频的色彩延伸到屏幕四周。实时氛围光、柔和过渡、深色背景，所有处理均在本地完成。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "action": {"default_title":"Ambient light for Bilibili","default_popup":"popup.html"},
  "background": {"service_worker":"background.js"},
  "commands": {"toggle-ambient":{"suggested_key":{"default":"Alt+Shift+A"},"description":"开启 / 关闭 Bilibili 氛围光"}},
  "content_scripts": [{
    "matches": ["https://www.bilibili.com/*"],
    "js": ["shared.js", "preview.js", "bars.js", "bar-effects.js", "content.js"],
    "css": ["page.css"],
    "run_at": "document_idle"
  }]
}
